<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title and page.url != "/" %}{{ title }} | {{ site.name }} KRNA{% else %}{{ site.name }} KRNA | {{ title or "로봇 자동화·스마트공장 구축 전문기업" }}{% endif %}</title>
<meta name="description" content="{{ description or site.description }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
{% if site.naverVerification %}<meta name="naver-site-verification" content="{{ site.naverVerification }}">
{% endif %}<meta property="og:site_name" content="{{ site.name }} KRNA">
<meta property="og:title" content="{% if page.url == "/" %}{{ site.name }} KRNA{% else %}{{ title or site.name }}{% endif %}">
<meta property="og:description" content="{{ description or site.description }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}{{ image or '/images/og.jpg' }}">
<meta property="og:type" content="website">
{% if page.url == "/" %}<script type="application/ld+json">{"@context":"https://schema.org","@type":"Organization","name":"{{ site.name }}","alternateName":["케이알앤에이","KRNA","{{ site.nameEn }}"],"url":"{{ site.url }}/","logo":"{{ site.url }}/images/logo.png","telephone":"{{ site.tel }}","email":"{{ site.email }}","address":{"@type":"PostalAddress","streetAddress":"{{ site.address }}","postalCode":"{{ site.zip }}","addressCountry":"KR"}}</script>
{% endif %}<link rel="icon" href="/images/favicon.png">
<link rel="preconnect" href="https://cdn.jsdelivr.net">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css">
<link rel="stylesheet" href="/assets/css/style.css?v={{ build }}">
</head>
<body class="{{ bodyClass }}">
<a class="skip" href="#main">본문 바로가기</a>
<header class="hd" id="hd">
  <div class="wrap hd-in">
    <a class="logo" href="/"><img src="/images/logo.png" alt="KRNA" width="133" height="46"><span class="logo-ko">(주)케이알앤에이</span></a>
    <nav class="gnb" aria-label="주 메뉴">
      <ul>
      {% for m in nav %}
        <li class="{% if page.url.startsWith(m.url) and not (m.url == "/support/" and page.url == "/support/contact/") %}on{% endif %}"><a href="{{ m.url }}">{{ m.title }}</a>
          {% if m.children.length %}<ul class="sub">{% for c in m.children %}<li><a href="{{ c.url }}">{{ c.title }}</a></li>{% endfor %}</ul>{% endif %}
        </li>
      {% endfor %}
      </ul>
    </nav>
    <button class="menu-btn" aria-label="메뉴 열기" aria-expanded="false"><span></span><span></span><span></span></button>
  </div>
</header>

<main id="main">
{% if section %}
<section class="sub-hero">
  <div class="wrap">
    <p class="eyebrow">{{ sectionEn }}</p>
    <h1>{{ title }}</h1>
    {% if lead %}<p class="lead">{{ lead }}</p>{% endif %}
  </div>
</section>
{% for m in nav %}{% if m.title == section %}
<nav class="lnb" aria-label="{{ section }} 하위 메뉴"><div class="wrap"><ul>
  {% for c in m.children %}<li><a href="{{ c.url }}" class="{% if c.url == page.url %}on{% endif %}">{{ c.title }}</a></li>{% endfor %}
</ul></div></nav>
{% endif %}{% endfor %}
{% endif %}
{{ content | safe }}
</main>

<footer class="ft">
  <div class="wrap ft-top">
    <div>
      <img class="ft-logo" src="/images/logo-full-white.png" alt="KRNA 케이알앤에이" width="155" height="75">
      <p class="ft-slogan">{{ site.slogan }}</p>
    </div>
    <div class="ft-contact">
      <p><strong>T.</strong> <a href="tel:{{ site.tel }}">{{ site.tel }}</a></p>
      <p><strong>F.</strong> {{ site.fax }}</p>
      <p><strong>E.</strong> <a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
    </div>
  </div>
  <div class="wrap ft-info">
    <p>{{ site.name }} <span>대표이사 {{ site.ceo }}</span> <span>사업자등록번호 {{ site.bizNo }}</span></p>
    <p>{{ site.address }}</p>
    <p class="copy">© {{ "" | year }} KRNA Co., Ltd. All rights reserved. · <a href="/privacy/">개인정보처리방침</a></p>
  </div>
</footer>
<script src="/assets/js/main.js?v={{ build }}" defer></script>
</body>
</html>
